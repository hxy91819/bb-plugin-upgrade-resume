    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.6",
    "hono": "^4.13.22",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
