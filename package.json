{
  "name": "bb-plugin-upgrade-resume",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Resume BB threads interrupted by a prepared server upgrade.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxy91819/bb-plugin-upgrade-resume.git"
  },
  "engines": {
